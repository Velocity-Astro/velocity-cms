---
import { getLiveCollection } from 'astro:content';
import { LIKES_SCRIPT, typeLikes } from '@velocity-astro/cms-astro';
import Layout from '@/layouts/Layout.astro';

export const prerender = false;

interface Post {
  id: string;
  slug: string;
  title?: string;
  date?: string;
  excerpt?: string;
}

const { entries = [], error, cacheHint } = await getLiveCollection('posts');
if (error) throw error;
// Kept until a post is published, then drawn again.
if (cacheHint) Astro.cache.set(cacheHint);
const posts = entries.map((entry) => ({ ...(entry.data as unknown as Post), id: entry.id })).sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
// Each post shows how many liked it, when posts take likes and their settings show the count. The
// count is asked for by the page's script, so a kept copy of this page is never behind.
const likes = await typeLikes('posts');
---

<Layout title="Blog" description="Posts from this site.">
  <section class="band">
    <div class="wrap narrow">
      <h1>Blog</h1>
      {posts.length === 0 && <p class="lead">No posts yet. Write one under Posts in the editor.</p>}
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`}>{post.title}</a>
            <div class="meta">
              {post.date && <time datetime={post.date}>{post.date}</time>}
              {likes?.showCount && (
                <span class="like-count">
                  <span class="visually-hidden">Likes:</span>
                  <span data-cms-like-type="posts" data-cms-like-entry={post.id} data-cms-like-count hidden></span>
                </span>
              )}
            </div>
            {post.excerpt && <p>{post.excerpt}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
  {likes?.showCount && <script src={LIKES_SCRIPT} defer></script>}
</Layout>
