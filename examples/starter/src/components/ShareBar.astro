---
/**
 * The bar that floats at the foot of a post: a like button with how many liked it, and ways to
 * share the post (the phone's own share sheet, copy the link, X, LinkedIn). Likes are switched
 * on for a type in its settings in the editor; without them the bar only shares.
 * `/cms-likes.js` makes the buttons work. Without scripts the X and LinkedIn links still do.
 */
import { LIKES_SCRIPT, shareLinks, siteLikes } from '@velocity-astro/cms-astro';

interface Props {
  title: string;
}

const likes = await siteLikes(Astro);
const share = shareLinks(Astro, Astro.props.title);
---

<aside class="share-bar" aria-label="Like and share">
  {
    likes && (
      <button
        type="button"
        class="share-bar__like"
        data-cms-like
        data-cms-like-type={likes.type}
        data-cms-like-entry={likes.entry}
        data-cms-like-liked="You liked this post."
        data-cms-like-unliked="You took your like back."
        aria-pressed="false"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M12 20.5s-7.5-4.6-9.4-9.3C1.3 7.9 3.4 4.5 6.9 4.5c2 0 3.6 1.1 5.1 3 1.5-1.9 3.1-3 5.1-3 3.5 0 5.6 3.4 4.3 6.7-1.9 4.7-9.4 9.3-9.4 9.3Z" /></svg>
        <span class="share-bar__word">Like</span>
        {likes.showCount && <span class="share-bar__count" data-cms-like-count hidden />}
      </button>
    )
  }
  <span class="share-bar__rule" aria-hidden="true"></span>
  <button type="button" class="share-bar__icon" data-cms-share="native" data-cms-share-url={share.url} data-cms-share-title={Astro.props.title} hidden>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /></svg>
    <span class="visually-hidden">Share</span>
  </button>
  <button type="button" class="share-bar__icon" data-cms-share="copy" data-cms-share-url={share.url} data-cms-share-copied="The link was copied.">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
    <span class="visually-hidden">Copy the link</span>
  </button>
  <a class="share-bar__icon" href={share.x} target="_blank" rel="noopener">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path class="filled" d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.3-8.3L2 3h6.4l4.4 5.8Zm-1.1 16.2h1.7L7.4 4.7H5.6Z" /></svg>
    <span class="visually-hidden">Share on X</span>
  </a>
  <a class="share-bar__icon" href={share.linkedin} target="_blank" rel="noopener">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path class="filled" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3Zm7 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4Z" /></svg>
    <span class="visually-hidden">Share on LinkedIn</span>
  </a>
  <span class="visually-hidden" role="status" data-cms-like-status data-cms-share-status></span>
</aside>
<script src={LIKES_SCRIPT} defer></script>
