---
/**
 * One of the site's forms, chosen in the editor. Its fields come from the CMS as they are today,
 * so a field added under Forms is on the page at once. A form that is closed or gone leaves the
 * section out. It posts as a plain form; with scripts on, /cms-form.js sends it in place.
 */
import { FORM_SCRIPT, fieldMark, siteForm } from '@velocity-astro/cms-astro';

interface Props {
  title?: string;
  lead?: string;
  /** The id of the form, as the CMS keeps the choice. */
  form?: string;
}

type Words = Readonly<Record<string, string>>;

const { title, lead, form: chosen } = Astro.props;
const form = chosen ? await siteForm(Astro, { id: chosen }) : null;
const say = (words: Words | undefined) => words?.en ?? Object.values(words ?? {})[0];
const kinds: Record<string, string> = { text: 'text', number: 'text', date: 'date', url: 'url', email: 'email', phone: 'tel' };
const fields = (form?.fields ?? []).map((field) => {
  const options = field.options as { multiline?: boolean; maxLength?: number; choices?: string[]; labels?: Record<string, Words> };
  return { ...field, options, label: say(field.label) ?? field.key, hint: say(field.help) };
});
---

{
  form && (
    <section class="band">
      <div class="wrap narrow">
        <h1 {...fieldMark('title')}>{title ?? say(form.label)}</h1>
        {lead && <p class="lead">{lead}</p>}
        <form action={form.action} method="post" class="form" data-cms-form data-cms-form-failed="That could not be sent. Please try again.">
          {Object.entries(form.hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
          {fields.map((field) => (
            <div class="field">
              {field.type === 'boolean' ? (
                <label class="check">
                  <input type="checkbox" name={field.key} required={field.required} /> {field.label}
                </label>
              ) : (
                <label for={`f-${field.key}`}>{field.label}</label>
              )}
              {field.type === 'select' && (
                <select id={`f-${field.key}`} name={field.key} required={field.required}>
                  <option value="" />
                  {(field.options.choices ?? []).map((value) => <option value={value}>{say(field.options.labels?.[value]) ?? value}</option>)}
                </select>
              )}
              {field.type === 'text' && field.options.multiline && <textarea id={`f-${field.key}`} name={field.key} rows="5" required={field.required} maxlength={field.options.maxLength} />}
              {field.type in kinds && !field.options.multiline && <input id={`f-${field.key}`} type={kinds[field.type]} name={field.key} required={field.required} maxlength={field.options.maxLength} />}
              {field.hint && <p class="hint">{field.hint}</p>}
              <p class="error" data-cms-form-error={field.key} role="alert" hidden />
            </div>
          ))}
          <div class="trap" aria-hidden="true">
            <input type="text" name={form.trap} tabindex="-1" autocomplete="off" />
          </div>
          <button class="button" type="submit" data-cms-form-sending="Sending…">{say(form.submitLabel) ?? 'Send'}</button>
          <p role="status" data-cms-form-status hidden />
        </form>
      </div>
    </section>
  )
}
<script is:inline type="module" src={FORM_SCRIPT}></script>
