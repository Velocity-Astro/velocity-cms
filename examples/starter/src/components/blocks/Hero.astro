---
import { fieldMark, linkTo } from '@velocity-astro/cms-astro';
import type { Link } from '../blocks';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  buttonLabel?: string;
  buttonTo?: Link;
}

const { eyebrow, title, lead, buttonLabel, buttonTo } = Astro.props;
const button = buttonLabel ? await linkTo(Astro, buttonTo) : undefined;
---

<section class="band hero">
  <div class="wrap">
    {eyebrow && <p class="eyebrow" {...fieldMark('eyebrow')}>{eyebrow}</p>}
    <h1 {...fieldMark('title')}>{title}</h1>
    {lead && <p class="lead" {...fieldMark('lead')}>{lead}</p>}
    {button && <a class="button" href={button.href} {...fieldMark('buttonLabel')}>{buttonLabel}</a>}
  </div>
</section>
