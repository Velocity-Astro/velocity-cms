---
import { allowEmbeds } from '@velocity-astro/cms-astro';
import type { RichText } from '../blocks';

interface Props {
  title?: string;
  body?: RichText;
}

const { title, body } = Astro.props;
// A video or a map in the text is allowed by the page's policy.
allowEmbeds(Astro, body);
---

<section class="band">
  <div class="wrap narrow">
    {title && <h2>{title}</h2>}
    <div class="prose" set:html={body?.html ?? ''} />
  </div>
</section>
