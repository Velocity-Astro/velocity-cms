---
/**
 * Draws a page's sections in order. A section of a kind this site has no component for is left
 * out. Beside the editor's form each section says which one it is, so a click finds it in the form.
 */
import { isEditorPreview } from '@velocity-astro/cms-astro';
import { blocks, type Section } from './blocks';

interface Props {
  sections?: Section[];
}

const { sections = [] } = Astro.props;
const known = sections.flatMap((section) => {
  const Block = blocks[section.block];
  return Block ? [{ Block, section }] : [];
});
const marked = isEditorPreview();
---

{known.map(({ Block, section }) => (marked ? <div data-cms-section={section.id}><Block {...section.data} /></div> : <Block {...section.data} />))}
