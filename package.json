{
  "name": "velocity-cms",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @velocity/cms-admin build:app",
    "check": "tsc -b",
    "lint": "eslint . && pnpm --filter @velocity/cms-ui check",
    "test": "pnpm build && vitest run",
    "validate": "pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
