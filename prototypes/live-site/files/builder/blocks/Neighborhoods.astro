---
/** The neighborhood guides, straight from the CMS: the first large, four more beside it. */
import Band from '@/components/estate/Band.astro';
import EstateButton from '@/components/estate/EstateButton.astro';
import NeighborhoodCard from '@/components/estate/NeighborhoodCard.astro';
import { getAvailable, getNeighborhoods } from '@/content/estate';
import { getLocale, localizeRoute } from '@/i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  linkLabel?: string;
}

const { eyebrow, title, linkLabel } = Astro.props;
const locale = getLocale(Astro);
const route = (id: Parameters<typeof localizeRoute>[0]) => localizeRoute(id, locale);
const [forSale, forRent, neighborhoods] = await Promise.all([getAvailable(locale, 'sale'), getAvailable(locale, 'rent'), getNeighborhoods(locale)]);
const countIn = (slug: string) => [...forSale, ...forRent].filter(({ data }) => data.neighborhood === slug).length;
---

<Band eyebrow={eyebrow} title={title} width="wide">
  {linkLabel && <EstateButton slot="action" tone="link" href={route('neighborhoods')} trailingIcon="arrow-right">{linkLabel}</EstateButton>}
  <ul class="grid grid-cols-2 gap-4 lg:h-[38rem] lg:grid-cols-4 lg:grid-rows-2" data-reveal-group>
    {neighborhoods.slice(0, 5).map(({ data }, index) => (
      <li class:list={[index === 0 ? 'col-span-2 lg:row-span-2' : '', index === 0 ? 'h-80 sm:h-[28rem] lg:h-auto' : 'h-60 lg:h-auto']}>
        <NeighborhoodCard neighborhood={data} count={countIn(data.slug)} ratio="fill" />
      </li>
    ))}
  </ul>
</Band>
