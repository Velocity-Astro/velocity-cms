---
/** How something works: a heading and a photo that stay in view beside numbered steps. */
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import Band from '@/components/estate/Band.astro';
import Steps from '@/components/premium/Steps.astro';
import { getLocale, useTranslations } from '@/i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  photo?: string;
  items?: { title?: string; text?: string }[];
}

const { eyebrow, title, photo, items = [] } = Astro.props;
const t = useTranslations(getLocale(Astro));
const steps = items.map((item) => ({ title: item.title ?? '', body: item.text ?? '' }));
---

<Band width="wide" tone="secondary">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-20">
    <div class="flex flex-col gap-5 lg:sticky lg:top-28 lg:self-start">
      {eyebrow && <p class="estate-eyebrow">{eyebrow}</p>}
      <h2 class="estate-display text-4xl sm:text-5xl">{title}</h2>
      {photo && (
        <div class="estate-zoom relative mt-4 overflow-hidden rounded-3xl max-lg:hidden" data-reveal>
          <MediaSlot photo={photo} alt="" ratio="4/3" sizes="34rem" label={t('media.exterior')} />
        </div>
      )}
    </div>
    <Steps steps={steps} layout="large" />
  </div>
</Band>
