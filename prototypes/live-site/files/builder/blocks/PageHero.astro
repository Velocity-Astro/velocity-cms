---
/** The opening of a page: its heading, a line under it, and a photo beside it on wide screens. */
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import PageHero from '@/components/estate/PageHero.astro';

interface Props {
  title?: string;
  eyebrow?: string;
  lead?: string;
  size?: 'md' | 'lg';
  background?: 'plain' | 'grain' | 'glow' | 'gradient';
  photo?: string;
  photoAlt?: string;
}

const { title = '', eyebrow, lead, size = 'md', background = 'glow', photo, photoAlt = '' } = Astro.props;
---

{
  photo ? (
    <PageHero eyebrow={eyebrow} title={title} lead={lead} size={size} background={background}>
      <MediaSlot slot="aside" photo={photo} alt={photoAlt} ratio="4/5" sizes="30rem" priority />
    </PageHero>
  ) : (
    <PageHero eyebrow={eyebrow} title={title} lead={lead} size={size} background={background} />
  )
}
