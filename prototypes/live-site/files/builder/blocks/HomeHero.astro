---
/**
 * The home page's opening: a headline and the search over a blurred photo, with the photo and
 * one listing beside it. The search and the listing's card are the template's own.
 */
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import HeroSearch from '@/components/estate/HeroSearch.astro';
import { estate, formatPrice } from '@/config/estate.config';
import { getAvailable, getListing, getNeighborhoods, listingUrl, streetLine } from '@/content/estate';
import { getLocale, useTranslations } from '@/i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  lead?: string;
  photo?: string;
  photoAlt?: string;
  points?: string[];
  listing?: string;
}

const { eyebrow, title = '', titleAccent, lead, photo = 'room-living-modern', photoAlt = '', points = [], listing } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const [chosen, forSale, neighborhoods] = await Promise.all([getListing(listing ?? estate.home.spotlight, locale), getAvailable(locale, 'sale'), getNeighborhoods(locale)]);
const spotlight = chosen?.data ?? forSale[0]?.data;
const hoodName = new Map(neighborhoods.map(({ data }) => [data.slug, data.name]));
---

<section class="estate-under-header invert-section bg-surface-invert relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <MediaSlot photo={photo} alt="" ratio="fill" sizes="60vw" priority tone="brand" label={t('media.hero')} imageClass="scale-110 blur-xl" />
    <span class="estate-grain absolute inset-0"></span>
    <span class="estate-hero-scrim absolute inset-0"></span>
  </div>
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 pt-10 pb-16 sm:px-8 md:pt-14 md:pb-20 lg:min-h-[min(88svh,52rem)] lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
    <div class="flex min-w-0 flex-col gap-6">
      {eyebrow && <p class="estate-glass kit-enter text-on-invert self-start rounded-full px-3.5 py-1.5 text-[0.8125rem] font-semibold">{eyebrow}</p>}
      <h1 class="estate-display estate-hero-title kit-enter kit-enter-2 text-4xl sm:text-5xl xl:text-6xl">{title} {titleAccent && <em>{titleAccent}</em>}</h1>
      {lead && <p class="text-on-invert-secondary kit-enter kit-enter-3 max-w-xl text-lg">{lead}</p>}
      <HeroSearch class="kit-enter kit-enter-4 mt-1" />
      <ul class="text-on-invert-secondary kit-enter kit-enter-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {points.map((point) => (
          <li class="flex items-center gap-2"><Icon name="check" size="sm" strokeWidth={2.5} class="text-brand-300" />{point}</li>
        ))}
      </ul>
    </div>
    <div class="kit-settle relative min-w-0">
      <MediaSlot photo={photo} alt={photoAlt} ratio="4/3" sizes="(min-width: 1024px) 40vw, 100vw" priority tone="brand" label={t('media.hero')} class="rounded-3xl shadow-2xl lg:aspect-[5/6] xl:aspect-[4/4.4]" />
      {spotlight && (
        <a href={listingUrl(spotlight, locale)} class="estate-on-paper kit-lift absolute bottom-5 left-5 flex max-w-[calc(100%-2.5rem)] items-center gap-3.5 rounded-2xl p-3 pr-5 shadow-xl">
          <span class="relative block w-16 shrink-0 overflow-hidden rounded-xl"><MediaSlot photo={spotlight.photos[0]} alt="" ratio="1/1" sizes="64px" label="" /></span>
          <span class="flex min-w-0 flex-col leading-snug">
            <span class="text-foreground-muted text-xs font-medium">{t('home.hero.spotlight', { area: hoodName.get(spotlight.neighborhood) ?? spotlight.address.city })}</span>
            <span class="estate-figure font-bold">{formatPrice(spotlight.price)}</span>
            <span class="text-foreground-secondary truncate text-sm">{streetLine(spotlight)}</span>
          </span>
        </a>
      )}
    </div>
  </div>
</section>
