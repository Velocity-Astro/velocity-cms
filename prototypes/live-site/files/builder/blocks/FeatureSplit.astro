---
/** A photo on one side, and on the other a heading, text and a button. */
import Band from '@/components/estate/Band.astro';
import EstateButton from '@/components/estate/EstateButton.astro';
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import { safeLink, type RichText } from '@/cms/blocks';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: RichText;
  photo?: string;
  photoAlt?: string;
  photoSide?: 'left' | 'right';
  tone?: 'default' | 'secondary';
  buttonLabel?: string;
  buttonLink?: string;
}

const { eyebrow, title, body, photo, photoAlt = '', photoSide = 'right', tone = 'default', buttonLabel, buttonLink } = Astro.props;
const href = safeLink(buttonLink);
---

<Band tone={tone} width="wide">
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <div class:list={['flex flex-col gap-5', photoSide === 'left' && 'lg:order-2']}>
      {eyebrow && <p class="text-brand-600 dark:text-brand-400 text-xs font-bold tracking-[0.12em] uppercase">{eyebrow}</p>}
      {title && <h2 class="estate-display text-3xl sm:text-4xl">{title}</h2>}
      <div class="estate-rich-text text-foreground-secondary flex flex-col gap-4 text-[1.0625rem] leading-relaxed" set:html={body?.html ?? ''} />
      {buttonLabel && href && <div><EstateButton href={href} trailingIcon="arrow-right">{buttonLabel}</EstateButton></div>}
    </div>
    <MediaSlot photo={photo} alt={photoAlt} ratio="4/3" sizes="40rem" class="overflow-hidden rounded-2xl" />
  </div>
</Band>
