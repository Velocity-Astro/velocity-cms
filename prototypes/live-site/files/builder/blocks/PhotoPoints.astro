---
/** Two photos and a figure on one side; a heading, a list of short points and two buttons on the other. */
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Band from '@/components/estate/Band.astro';
import EstateButton from '@/components/estate/EstateButton.astro';
import { safeLink } from '@/cms/blocks';
import { getLocale, useTranslations } from '@/i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  photo?: string;
  photoAlt?: string;
  secondPhoto?: string;
  figureLabel?: string;
  figure?: string;
  figureUnit?: string;
  points?: string[];
  buttonLabel?: string;
  buttonLink?: string;
  secondLabel?: string;
  secondLink?: string;
}

const { eyebrow, title, lead, photo, photoAlt = '', secondPhoto, figureLabel, figure, figureUnit, points = [], buttonLabel, buttonLink, secondLabel, secondLink } = Astro.props;
const t = useTranslations(getLocale(Astro));
const first = safeLink(buttonLink);
const second = safeLink(secondLink);
const pmPoints = points;
---

<Band tone="secondary" width="wide" background="grain">
  <div class="grid items-center gap-16 lg:grid-cols-2 lg:gap-20">
    <div class="relative pb-14 sm:pr-16" data-reveal>
      <div class="estate-zoom relative overflow-hidden rounded-3xl">
        <MediaSlot photo={photo} alt={photoAlt} ratio="4/5" sizes="(min-width: 1024px) 34rem, 100vw" label={t('media.interior')} />
      </div>
      {secondPhoto && (
        <div class="estate-frame absolute right-0 bottom-0 w-[46%] overflow-hidden rounded-2xl max-sm:hidden">
          <MediaSlot photo={secondPhoto} alt="" ratio="1/1" sizes="16rem" label={t('media.exterior')} />
        </div>
      )}
      {figure && <div class="bg-background estate-frame absolute top-6 -left-3 flex flex-col gap-1 rounded-2xl px-5 py-4 sm:-left-6">
        <span class="text-foreground-muted text-xs font-semibold tracking-wide uppercase">{figureLabel}</span>
        <span class="estate-display estate-figure text-brand-600 dark:text-brand-400 text-4xl">{figure}</span>
        <span class="text-foreground-secondary text-sm">{figureUnit}</span>
      </div>}
    </div>
    <div class="flex flex-col gap-5">
      {eyebrow && <p class="estate-eyebrow">{eyebrow}</p>}
      <h2 class="estate-display text-4xl sm:text-5xl">{title}</h2>
      {lead && <p class="text-foreground-secondary text-lg">{lead}</p>}
      <ul class="border-border mt-2 grid border-t sm:grid-cols-2 sm:gap-x-8">
        {pmPoints.map((point) => (
          <li class="border-border flex items-center gap-3 border-b py-3.5 font-medium">
            <span class="bg-brand-100 text-brand-700 dark:text-brand-400 grid size-7 shrink-0 place-items-center rounded-full"><Icon name="check" size="xs" strokeWidth={3} /></span>
            {point}
          </li>
        ))}
      </ul>
      <div class="mt-3 flex flex-wrap gap-3">
        {buttonLabel && first && <EstateButton href={first} size="lg">{buttonLabel}</EstateButton>}
        {secondLabel && second && <EstateButton tone="outline" href={second} size="lg">{secondLabel}</EstateButton>}
      </div>
    </div>
  </div>
</Band>
