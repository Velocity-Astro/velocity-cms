---
/** A few points side by side, each with an icon, a name and a line. */
import Band from '@/components/estate/Band.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  tone?: 'default' | 'secondary';
  columns?: '2' | '3' | '4';
  items?: { icon?: string; title?: string; text?: string }[];
}

const { eyebrow, title, tone = 'secondary', columns = '4', items = [] } = Astro.props;
const grid = { '2': 'sm:grid-cols-2', '3': 'sm:grid-cols-2 lg:grid-cols-3', '4': 'sm:grid-cols-2 lg:grid-cols-4' }[columns] ?? 'sm:grid-cols-2 lg:grid-cols-4';
---

<Band tone={tone} width="wide" background={tone === 'secondary' ? 'grain' : 'plain'} eyebrow={eyebrow} title={title}>
  <ul class:list={['grid gap-6', grid]} data-reveal-group>
    {
      items.map((item) => (
        <li class="flex">
          <Card padding="none" class="bg-background border-border flex w-full flex-col gap-3 rounded-2xl p-6">
            <span class="bg-brand-100 text-brand-700 dark:text-brand-400 grid size-11 place-items-center rounded-xl">
              <Icon name={item.icon ?? 'check'} size="md" />
            </span>
            <span class="font-semibold">{item.title}</span>
            {item.text && <span class="text-foreground-secondary text-[0.9375rem]">{item.text}</span>}
          </Card>
        </li>
      ))
    }
  </ul>
</Band>
