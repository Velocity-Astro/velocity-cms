---
/**
 * One of the site's forms, chosen in the editor, with a heading beside it. The form's fields
 * come from the CMS as they are today, so a field added under Forms is on the page at once.
 * A form that is closed or gone leaves the whole section out.
 *
 * It posts to the CMS as a plain form. With scripts on, /cms-form.js sends it in place and
 * writes each problem under its field.
 */
import { siteForm } from '@velocity/cms-astro';
import CmsForm from '@/components/cms/CmsForm.astro';
import Band from '@/components/estate/Band.astro';
import { getLocale } from '@/i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  /** The id of the form, as the CMS keeps the choice. */
  form?: string;
  tone?: 'default' | 'secondary';
}

type Words = Readonly<Record<string, string>>;

const { eyebrow, title, lead, form: chosen, tone = 'default' } = Astro.props;
const locale = getLocale(Astro);
const form = chosen ? await siteForm(Astro, { id: chosen }) : null;
const say = (words: Words | undefined) => words?.[locale] ?? words?.en ?? Object.values(words ?? {})[0];
---

{
  form && (
    <Band tone={tone} width="wide">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="flex flex-col gap-4">
          {eyebrow && <p class="estate-eyebrow">{eyebrow}</p>}
          <h2 class="estate-display text-3xl sm:text-4xl">{title ?? say(form.label)}</h2>
          {lead && <p class="text-foreground-secondary text-lg">{lead}</p>}
        </div>
        <CmsForm form={form} />
      </div>
    </Band>
  )
}
