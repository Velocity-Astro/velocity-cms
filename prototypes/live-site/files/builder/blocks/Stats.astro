---
/** A row of figures, each with what it counts. */
import Band from '@/components/estate/Band.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  tone?: 'default' | 'secondary' | 'invert';
  items?: { value?: string; label?: string }[];
}

const { eyebrow, title, tone = 'invert', items = [] } = Astro.props;
---

<Band tone={tone} width="wide" eyebrow={eyebrow} title={title}>
  <dl class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {
      items.map((item) => (
        <div class="flex flex-col-reverse gap-2">
          <dt class="text-foreground-secondary text-[0.9375rem]">{item.label}</dt>
          <dd class="estate-display text-4xl sm:text-5xl">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</Band>
