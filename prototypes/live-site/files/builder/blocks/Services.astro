---
/** What the business does: photo cards that turn over for a line about each and a way in. */
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import Icon, { type IconName } from '@/components/ui/primitives/Icon/Icon.astro';
import Band from '@/components/estate/Band.astro';
import { linkTo } from '@velocity/cms-astro';
import { getLocale, useTranslations } from '@/i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  items?: { icon?: string; photo?: string; title?: string; text?: string; linkLabel?: string; linkTo?: unknown }[];
}

const { eyebrow, title, lead, items = [] } = Astro.props;
const t = useTranslations(getLocale(Astro));
const services = await Promise.all(
  items.map(async (item) => ({
  icon: (item.icon ?? 'home') as IconName,
  photo: item.photo,
  title: item.title ?? '',
  body: item.text ?? '',
  cta: item.linkLabel ?? '',
  href: (await linkTo(Astro, item.linkTo))?.href ?? '#',
  })),
);
---

<Band eyebrow={eyebrow} title={title} lead={lead} width="wide" center>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {services.map((service, index) => (
      <li>
        <a href={service.href} class="estate-flip block aspect-[3/4] min-h-96 sm:min-h-0">
          <span class="estate-flip-inner">
            <span class="estate-flip-face invert-section bg-surface-invert flex flex-col">
              <MediaSlot photo={service.photo} alt="" ratio="fill" sizes="(min-width: 1024px) 22rem, (min-width: 640px) 50vw, 100vw" tone="brand" label={t('media.exterior')} imageClass="transition-transform duration-700" />
              <span class="estate-scrim-top absolute inset-x-0 top-0 h-1/3" aria-hidden="true"></span>
              <span class="estate-scrim-bottom absolute inset-x-0 bottom-0 h-3/4" aria-hidden="true"></span>
              <span class="estate-glass text-on-invert absolute top-5 left-5 grid size-12 place-items-center rounded-full" aria-hidden="true"><Icon name={service.icon} size="md" strokeWidth={1.75} /></span>
              <span class="estate-display text-on-invert/70 absolute top-6 right-6 text-lg" aria-hidden="true">0{index + 1}</span>
              <span class="relative mt-auto flex flex-col gap-3 p-6">
                <span class="estate-display text-on-invert text-[1.75rem]">{service.title}</span>
                <span class="estate-flip-touch text-on-invert-secondary text-[0.9375rem]">{service.body}</span>
                <span class="estate-flip-touch text-on-invert inline-flex items-center gap-1.5 text-[0.9375rem] font-semibold">{service.cta}<Icon name="arrow-right" size="sm" /></span>
              </span>
            </span>
            <span class="estate-flip-face estate-flip-back estate-band-brand estate-bg-glow flex-col p-7">
              <span class="relative flex items-center justify-between" aria-hidden="true">
                <Icon name={service.icon} size="xl" strokeWidth={1.5} />
                <span class="estate-display text-lg opacity-70">0{index + 1}</span>
              </span>
              <span class="estate-display relative mt-auto text-[1.75rem]" aria-hidden="true">{service.title}</span>
              <span class="relative mt-3 text-base leading-relaxed">{service.body}</span>
              <span class="bg-paper text-brand-700 relative mt-6 inline-flex min-h-11 items-center justify-center gap-2 self-start rounded-lg px-4 text-[0.9375rem] font-semibold">{service.cta}<Icon name="arrow-right" size="sm" /></span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Band>
