---
/**
 * An invitation to sellers: a field for their address that starts the valuation, the latest
 * results from the listings, and a photo.
 */
import Input from '@/components/ui/form/Input/Input.astro';
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import Band from '@/components/estate/Band.astro';
import EstateButton from '@/components/estate/EstateButton.astro';
import { formatPrice } from '@/config/estate.config';
import { getSold, listingUrl, streetLine } from '@/content/estate';
import { getLocale, localizeRoute, useTranslations } from '@/i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  buttonLabel?: string;
  photo?: string;
  photoAlt?: string;
  results?: 'show' | 'hide';
}

const { eyebrow, title, lead, buttonLabel, photo, photoAlt = '', results = 'show' } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const route = (id: Parameters<typeof localizeRoute>[0]) => localizeRoute(id, locale);
const sold = results === 'hide' ? [] : await getSold(locale);
---

<Band id="valuation" width="wide">
  <div class="border-border grid overflow-hidden rounded-3xl border lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
    <div class="flex flex-col gap-5 p-8 sm:p-12">
      {eyebrow && <p class="estate-eyebrow">{eyebrow}</p>}
      <h2 class="estate-display text-3xl sm:text-4xl">{title}</h2>
      {lead && <p class="text-foreground-secondary text-lg">{lead}</p>}
      <form action={`${route('sell')}#valuation`} method="get" class="flex flex-wrap gap-2">
        <Input name="address" type="text" size="lg" autocomplete="street-address" aria-label={t('forms.address')} placeholder={t('hero.placeholders.sell')} class="estate-field-lg min-w-0 flex-[1_1_16rem]" />
        <EstateButton type="submit" size="lg" class="rounded-lg leading-[inherit] max-sm:flex-1">{buttonLabel ?? t('home.valuation.cta')}</EstateButton>
      </form>
      {sold.length > 0 && (
        <div class="border-border mt-3 border-t pt-6">
          <p class="text-foreground-muted mb-3 text-sm font-semibold">{t('home.valuation.recent')}</p>
          <ul class="flex flex-col gap-2">
            {sold.slice(0, 3).map(({ data }) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 text-[0.9375rem]">
                <a href={listingUrl(data, locale)} class="font-medium hover:underline">{streetLine(data)}</a>
                <span class="estate-figure text-foreground-secondary">
                  {data.status === 'sold' ? t('home.valuation.soldFor', { price: formatPrice(data.soldPrice ?? data.price) }) : t('badges.leased')}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
    <div class="relative min-h-72">
      <MediaSlot photo={photo} alt={photoAlt} ratio="fill" sizes="(min-width: 1024px) 45vw, 100vw" label={t('media.interior')} />
    </div>
  </div>
</Band>
