---
/**
 * Every translated page, rendered on demand, and every page built in the editor. The translated
 * pages themselves live in src/live-pages/lang/, unchanged from when they were routes. A page the
 * site has a file for comes first; an address none of them owns is looked up in the CMS.
 */
import { entryPage, matchLocalizedPage } from '@velocity/cms-astro';
import BuilderPage from '@/components/cms/BuilderPage.astro';

export const prerender = false;

const pages = import.meta.glob('/src/live-pages/lang/*.astro', { eager: true });
const match = await matchLocalizedPage(pages, Astro.params.lang, Astro.params.path);
const built = match ? undefined : await entryPage(Astro, { types: ['pages'] });
if (!match && !built) return new Response(null, { status: 404 });
const Page = match?.Page;
---

{Page ? <Page {...match.props} /> : built && <BuilderPage page={built.entry.data} />}
