{
  "name": "@velocity-astro/cms-astro",
  "version": "0.1.0-beta.24",
  "description": "Velocity CMS for Astro: an open source CMS with its editor at /admin, pages built from sections on the live page, forms and a built-in CRM, on SQLite. The integration, a live loader for pages rendered on demand and a Content Layer loader for static builds.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "astro-integration",
    "astro-loader",
    "withastro",
    "astro",
    "cms",
    "headless-cms",
    "velocity-cms",
    "visual-editor",
    "page-builder",
    "forms",
    "crm",
    "sqlite",
    "libsql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velocity-Astro/velocity-cms.git",
    "directory": "packages/cms-astro"
  },
  "homepage": "https://docs.deployvelocity.com/cms/",
  "bugs": "https://github.com/Velocity-Astro/velocity-cms/issues",
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    }
  },
  "files": [
    "dist",
    "routes",
    "bin",
    "agents",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@velocity-astro/cms-admin": "workspace:*",
    "@velocity-astro/cms-api": "workspace:*",
    "@velocity-astro/cms-auth": "workspace:*",
    "@velocity-astro/cms-core": "workspace:*",
    "@velocity-astro/cms-db": "workspace:*",
    "@velocity-astro/cms-plugins": "workspace:*"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "astro": "7.4.5"
  },
  "astro": {
    "external": true
  },
  "bin": {
    "velocity-cms": "bin/velocity-cms.mjs"
  }
}
