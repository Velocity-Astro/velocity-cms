{
  "name": "@velocity/cms-astro",
  "version": "0.0.0",
  "description": "The Astro side of Velocity CMS: a live loader for pages rendered on demand, a Content Layer loader for static builds, and the integration.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    }
  },
  "files": [
    "dist",
    "routes",
    "bin",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@velocity/cms-admin": "workspace:*",
    "@velocity/cms-api": "workspace:*",
    "@velocity/cms-auth": "workspace:*",
    "@velocity/cms-core": "workspace:*",
    "@velocity/cms-db": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "astro": "7.4.5"
  },
  "astro": {
    "external": true
  },
  "bin": {
    "velocity-cms": "./bin/velocity-cms.mjs"
  }
}
