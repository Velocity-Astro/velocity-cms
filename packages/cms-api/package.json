{
  "name": "@velocity-astro/cms-api",
  "version": "0.1.0-beta.28",
  "description": "The Velocity CMS over HTTP: what the editor, the CLI and plugins call. Built on web-standard Request and Response, so it runs wherever the site does.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "velocity-cms",
    "cms",
    "astro",
    "api",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velocity-Astro/velocity-cms.git",
    "directory": "packages/cms-api"
  },
  "homepage": "https://docs.deployvelocity.com/cms/",
  "bugs": "https://github.com/Velocity-Astro/velocity-cms/issues",
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "skills": "node scripts/embed-skills.mjs"
  },
  "dependencies": {
    "@velocity-astro/cms-core": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "zod": "^4.6.6"
  }
}
