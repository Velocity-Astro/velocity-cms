{
  "name": "@velocity-astro/cms-admin",
  "version": "0.1.0-beta.15",
  "description": "The Velocity CMS editor: the screens people use to manage content. Built only from cms-ui parts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velocity-Astro/velocity-cms.git",
    "directory": "packages/cms-admin"
  },
  "homepage": "https://docs.deployvelocity.com/cms/",
  "bugs": "https://github.com/Velocity-Astro/velocity-cms/issues",
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./page-bridge": {
      "types": "./dist/page-bridge/index.d.ts",
      "default": "./dist/page-bridge/index.js"
    },
    "./package.json": "./package.json",
    "./app-directory": {
      "types": "./app-directory.d.mts",
      "default": "./app-directory.mjs"
    }
  },
  "files": [
    "dist",
    "app-dist",
    "app-directory.mjs",
    "app-directory.d.mts",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build:app": "vite build --config vite.app.config.ts --logLevel warn"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "@velocity-astro/cms-core": "workspace:*",
    "@velocity-astro/cms-ui": "workspace:*",
    "lucide-react": "^1.74.0",
    "react-router": "^8.5.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@velocity-astro/cms-api": "workspace:*",
    "@velocity-astro/cms-auth": "workspace:*",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.0.0"
  }
}
