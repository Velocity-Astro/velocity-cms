{
  "name": "@velocity-astro/cms-ui",
  "version": "0.1.0-beta.14",
  "description": "The Velocity CMS editor's design system: tokens, components and patterns. Knows nothing about content or the API.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velocity-Astro/velocity-cms.git",
    "directory": "packages/cms-ui"
  },
  "homepage": "https://docs.deployvelocity.com/cms/",
  "bugs": "https://github.com/Velocity-Astro/velocity-cms/issues",
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rich-text": {
      "types": "./dist/components/RichTextEditor/index.d.ts",
      "default": "./dist/components/RichTextEditor/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./registry.json": "./component-registry.json"
  },
  "files": [
    "dist",
    "src/**/*.css",
    "component-registry.json",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "check": "node scripts/check.mjs",
    "check:stories": "storybook build -o storybook-static --quiet && node scripts/check-stories.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.74.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.0.0"
  }
}
