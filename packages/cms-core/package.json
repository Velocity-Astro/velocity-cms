{
  "name": "@velocity-astro/cms-core",
  "version": "0.1.0-beta.19",
  "description": "The Velocity CMS content model and every rule about it. No database, no Astro, no HTTP.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velocity-Astro/velocity-cms.git",
    "directory": "packages/cms-core"
  },
  "homepage": "https://docs.deployvelocity.com/cms/",
  "bugs": "https://github.com/Velocity-Astro/velocity-cms/issues",
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./in-memory": {
      "types": "./dist/testing/in-memory.d.ts",
      "default": "./dist/testing/in-memory.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "peerDependencies": {
    "zod": "^4.6.6",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "zod": "^4.6.6",
    "vitest": "^5.1.0"
  }
}
