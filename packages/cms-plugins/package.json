{
  "name": "@velocity-astro/cms-plugins",
  "version": "0.1.0-beta.10",
  "description": "The plugins that come with Velocity CMS. Every site lists them under Plugins, switched off until an owner activates one.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velocity-Astro/velocity-cms.git",
    "directory": "packages/cms-plugins"
  },
  "homepage": "https://docs.deployvelocity.com/cms/",
  "bugs": "https://github.com/Velocity-Astro/velocity-cms/issues",
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "dependencies": {
    "@velocity-astro/cms-core": "workspace:*"
  },
  "devDependencies": {
    "@velocity-astro/cms-admin": "workspace:*"
  }
}
