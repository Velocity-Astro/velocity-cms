{
  "name": "@velocity-astro/cms-db",
  "version": "0.1.0-beta.12",
  "description": "SQLite and libSQL storage for Velocity CMS: tables, migrations and the repositories cms-core asks for.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Velocity-Astro/velocity-cms.git",
    "directory": "packages/cms-db"
  },
  "homepage": "https://docs.deployvelocity.com/cms/",
  "bugs": "https://github.com/Velocity-Astro/velocity-cms/issues",
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "migrations:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@velocity-astro/cms-core": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "peerDependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "zod": "^4.6.6"
  }
}
